APP_NAME=SAKANIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sakania_db
DB_USERNAME=sakania
# CHANGE THIS BEFORE ANY PRODUCTION DEPLOYMENT
DB_PASSWORD=change-me-strong-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sakania.ma"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,localhost:8000,127.0.0.1:8000

# Google Gemini API key for the chatbot (required for AI responses)
GEMINI_API_KEY=

# Google OAuth 2.0 ("Continue with Google"). Both values come from the Google
# Cloud console > APIs & Services > Credentials > OAuth client ID > Web
# application. Never commit real credentials: they belong in .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in the Google console, exactly. Google
# sends the browser to the backend here, which then redirects to FRONTEND_URL.
# The app is served through nginx on port 80, so that is the URL to register.
# Working on the Vite port instead? Use http://localhost:5173/api/auth/google/callback
# and http://localhost:5173, and register that URI too.
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# The React application the browser is sent back to once Google has answered.
FRONTEND_URL=http://localhost

# Seeded demo account passwords (consumed by DatabaseSeeder)
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_OWNER_PASSWORD=owner123
DEFAULT_TENANT_PASSWORD=tenant123

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api

# Boosthis performance monitoring (kit: lib/boosthis-php)
# Project key from the Boosthis dashboard > Project keys.
BOOSTHIS_PROJECT_KEY=
# Stable per-deployment UUID v4. Mint once, never change.
BOOSTHIS_INSTALL_ID=
BOOSTHIS_APP_NAME=sakanai-api
